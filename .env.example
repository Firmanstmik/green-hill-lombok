# Green Hill environment placeholders (no live credentials)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — Mapbox (independent third-party service)
# VITE_MAPBOX_ACCESS_TOKEN=

# Production address, e.g. https://greenhilllombok.com (absolute social image,
# sitemap.xml, robots.txt sitemap line). Left empty until the domain is confirmed.
# VITE_SITE_URL=

# Analytics (brief §10). Nothing loads unless set, and never in development.
# Decide on cookie consent for UK/EU visitors before enabling.
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_META_PIXEL_ID=000000000000000

# Demo builds only (QA, design review). Shows the six demo opportunities when
# no database is connected. Never set this for the real site; it has no effect
# once VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are set.
# VITE_DEMO_OPPORTUNITIES=true
